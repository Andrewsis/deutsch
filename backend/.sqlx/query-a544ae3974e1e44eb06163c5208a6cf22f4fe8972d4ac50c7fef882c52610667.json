{
  "db_name": "MySQL",
  "query": "\n        SELECT v.id, v.lemma,\n               COALESCE(t.translation, d.translation) AS translation,\n               v.prs3sg, v.prt3sg, v.pa2, v.aux\n        FROM verben_wide v\n        LEFT JOIN verb_translations t ON t.verb_id = v.id AND t.lang = ?\n        LEFT JOIN verb_translations d ON d.verb_id = v.id AND d.lang = ?\n        ORDER BY RAND()\n        LIMIT 10\n        ",
