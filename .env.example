# docker compose settings. Copy to .env and fill in.
DB_USER=deutsch
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too
JWT_SECRET=change-me-long-random-string
# Origins allowed by the backend. Behind nginx the frontend is same-origin,
# so this only matters for direct cross-origin calls to the API.
CORS_ORIGINS=http://localhost
RUST_LOG=info,tower_http=info
HTTP_PORT=80
# Public URL of the site (scheme + host [+ port if not 80/443]), no trailing slash.
# Used in canonical/hreflang links, sitemap.xml and robots.txt.
PUBLIC_ORIGIN=http://localhost
